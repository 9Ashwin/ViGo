{
  "name": "vigo",
  "productName": "ViGo",
  "version": "0.1.0",
  "private": true,
  "description": "V for your desktop — a LoL-style action wheel for macOS",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build:helper && electron-vite dev",
    "build:helper": "node native/hook-helper/run.mjs build && sh native/system-helper/build.sh",
    "test:helper": "node native/hook-helper/run.mjs test",
    "test:startup": "node tools/smoke-startup.mjs",
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:mac": "npm run build:icons && npm run build:helper && electron-vite build && electron-builder --mac --arm64 --publish never",
    "test": "npm run test:helper && node --experimental-transform-types --test tests/unit.test.ts",
    "build:icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@fluentui/react-motion-components-preview": "0.15.9",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "^40.10.6",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.vigo.desktop",
    "productName": "ViGo",
    "forceCodeSigning": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_LICENSES.md"
    ],
    "extraResources": [
      {
        "from": "native/hook-helper/build/hook-helper",
        "to": "hook-helper"
      },
      {
        "from": "build/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "build/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      },
      {
        "from": "native/system-helper/build/system-helper",
        "to": "system-helper"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/Electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/Chromium-LICENSES.html"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "type": "development",
      "timestamp": "none",
      "extendInfo": {
        "LSUIElement": true
      },
      "hardenedRuntime": false
    }
  }
}
